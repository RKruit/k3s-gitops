# Caddyfile for sv02 homelab
# Deployed to /etc/caddy/Caddyfile (bind-mounted from this file
# in the docker compose project).
#
# Hostnames: edit these. You handle DNS manually, so before
# `docker compose up -d caddy` make sure the A records point at
# this host's public IP. Caddy will issue Let's Encrypt certs
# via HTTP-01 challenge on first start, then auto-renew.

# === Frigate ===
# Frigate 0.16's nginx serves on port 5000 (plain HTTP, internal) and
# handles /api/*, /go2rtc/*, /web/*, /ws, /videos, /events, etc.
# We terminate TLS in Caddy and forward plain HTTP to the docker
# network DNS name.
frigate.sv02.oostrandpark.com {
    # We connect to Frigate by its container DNS name on the docker
    # bridge network (`sv02`). Caddy and Frigate are on the same
    # network in docker-compose.yml.
    reverse_proxy frigate.sv02.internal:5000 {
        # Bump timeouts: Frigate's /api/events can be slow, and the
        # WebSocket needs to stay open. In Caddy 2.8+, the dial/read/send
        # directives are sub-options of `transport` (or use the
        # simpler `timeouts` shorthand which sets all three).
        transport http {
            dial_timeout 5s
            read_timeout 60s
            write_timeout 60s
        }
    }

    # Frigate UI does some funky things; pass through everything.
    header {
        # Hide the Caddy fingerprint
        -Server
        # Allow WebSocket upgrades (frigate uses /ws for live updates)
    }

    # HLS streams (live view) — pass through the long-lived stream
    @hls path /videos/* /live/* /api/*/preview* /api/*/streaming*
    reverse_proxy @hls frigate.sv02.internal:5000
}

# === Optional: go2rtc (only if you want direct WebRTC access) ===
# go2rtc is bundled inside the Frigate container; Caddy can hit it on 1984
# (webrtc + api) or 8554 (rtsp) via the same Frigate container's network
# namespace. Most users don't need this — Frigate's UI already exposes
# everything. Uncomment if you want raw WebRTC access.
# go2rtc.sv02.oostrandpark.com:1984 {
#     reverse_proxy frigate.sv02.internal:1984
# }

# === Optional: Mosquitto WebSockets (for browser-based MQTT clients) ===
# Not needed for Frigate (it uses native MQTT on 1883 internally).
# Uncomment only if you have a specific browser-based MQTT dashboard.
# mqtt.sv02.oostrandpark.com {
#     reverse_proxy /ws mosquitto.sv02.internal:9001
# }

# === Internal-only / LAN services ===
# Optional: expose Caddy admin API on localhost only (for the sync.sh reload)
# Already default — Caddy admin is bound to 127.0.0.1:2019 by default.

# === Log everything to stdout (Caddy is running in a container) ===
{
    admin localhost:2019
    log default {
        output stdout
        format console
    }
}
