# Mosquitto credentials
# Mounted into the mosquitto container's ExecStartPre wrapper, which
# renders /srv/sv02/mosquitto/data/passwd from these.
#
# This is the same username/password as the k3s setup (usermqtt /
# ThisIs4Mqtt). When you rotate, change here AND in the Frigate env file
# (or just rotate both).
#
# DO NOT COMMIT THE ACTUAL FILE. The real one lives at:
#   /srv/sv02/secrets/mosquitto.env
# and is created by setup-host.sh with mode 0600.

MQTT_USER=usermqtt
MQTT_PASSWORD=replace-me-with-real-password
