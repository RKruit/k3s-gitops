# Mosquitto credentials as seen by the Frigate container
# Mounted into the Frigate container via EnvironmentFile= in
# frigate.container. The {FRIGATE_MQTT_USER} and {FRIGATE_MQTT_PASSWORD}
# placeholders in frigate.yml are resolved from these env vars at
# config-parse time.
#
# IMPORTANT: the values here MUST match MQTT_USER / MQTT_PASSWORD in
# /srv/sv02/secrets/mosquitto.env. They are kept in two separate env
# files so that:
#   - Rotation of camera creds doesn't require restarting Mosquitto
#   - Rotation of MQTT creds requires updating both env files AND
#     restarting both containers (they have the same password hash
#     stored in two places)
#
# DO NOT COMMIT THE ACTUAL FILE. The real one lives at:
#   /srv/sv02/secrets/frigate-mqtt.env
# and is created by setup-host.sh with mode 0600.

FRIGATE_MQTT_USER=usermqtt
FRIGATE_MQTT_PASSWORD=replac...nv