# Caddy reverse proxy
# - Terminates TLS for the hostnames in /etc/caddy/Caddyfile (which is a
#   symlink on the host → /opt/sv02-config/sv02/caddy/Caddyfile in the repo)
# - Issues Let's Encrypt certs via HTTP-01 (port 80)
# - Proxies to frigate.sv02.internal:5000 (the Frigate container)
# - Persists ACME account + certs to /srv/sv02/caddy/data
[Unit]
Description=Caddy reverse proxy
After=network-online.target sv02-network.service
Wants=sv02-network.service

[Container]
Image=docker.io/library/caddy:2.8-alpine
ContainerName=caddy
HostName=caddy.sv02.internal
Network=sv02.network
AutoUpdate=registry

# === Host port mappings ===
# Caddy needs 80 (HTTP-01 challenge + redirect) and 443 (TLS) on the host.
# Rootless podman binding to <1024 needs net.ipv4.ip_unprivileged_port_start=80
# (set by setup-host.sh).
PublishPort=80:80
PublishPort=443:443
# Caddy admin API on host loopback (sync.sh reloads via this)
PublishPort=127.0.0.1:2019:2019

# === Volume mounts (bind-mounts from the host) ===
# /etc/caddy/Caddyfile — symlink on the host pointing at the GitOps repo
Volume=/etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,z
# ACME account + certs (persisted across container restarts)
Volume=/srv/sv02/caddy/data:/data:z

# === Caddy-specific env ===
Environment=CADDY_DATA_DIR=/data
Environment=CADDY_CONFIG_DIR=/etc/caddy
Environment=XDG_DATA_HOME=/data

# === Lifecycle ===
Exec=/sbin/tini -- /usr/bin/caddy run --environ --config /etc/caddy/Caddyfile

# === Hardening (podman-side) ===
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300
# Note: ProtectSystem=strict and ProtectHome=true would hide
# /home/rkruit (where Caddy's ACME account lives) from the container.
# We rely on NoNewPrivileges=true and the rootless-podman isolation
# for the homelab threat model.
PrivateTmp=true

[Install]
WantedBy=default.target
