# Mosquitto MQTT broker
#
# Single instance, anonymous=false, no persistence (we don't need
# durable subscriptions — Frigate is the only consumer).
#
# Password is rendered into /srv/sv02/mosquitto/data/passwd by the
# render-mqtt-passwd.sh script (called via ExecStartPre below).
# This keeps the Quadlet simple (no heredoc inside it) and the
# passwd logic in a version-controlled script.
[Unit]
Description=Mosquitto MQTT broker
After=network-online.target sv02-network.service mqtt-data-volume.service
Wants=sv02-network.service
Requires=mqtt-data-volume.service

[Container]
Image=docker.io/library/eclipse-mosquitto:2.0
ContainerName=mosquitto
Hostname=mosquitto.sv02.internal
Network=sv02.network
AutoUpdate=registry

# Mounts
Volume=mqtt-data.volume:/mosquitto:z

# Environment (consumed by render-mqtt-passwd.sh)
EnvironmentFile=/srv/sv02/secrets/mosquitto.env

# Override the image's default entrypoint. The image's CMD points
# at /mosquitto/config/mosquitto.conf, but we mount our config at
# /mosquitto/data/mosquitto.conf (rendered by the pre-start script).
Exec=mosquitto -c /mosquitto/data/mosquitto.conf

# Port
PublishPort=1883:1883

# Restart
Restart=always
RestartSec=5s

# Hardening
SecurityOpt=label=disable
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Service]
# Render /mosquitto/data/{mosquitto.conf,passwd} before starting the
# container. This runs as the systemd user (rkruit via SUDO_USER
# from the install script), NOT inside the container.
ExecStartPre=/usr/bin/bash -c '/usr/bin/podman run --rm --network=none docker.io/library/eclipse-mosquitto:2.0 true' || true
# ^ Pre-pull the image so the actual ExecStartPre doesn't have to.
ExecStartPre=/opt/sv02-config/sv02/scripts/render-mqtt-passwd.sh
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
