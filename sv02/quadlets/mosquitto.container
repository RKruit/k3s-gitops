# Mosquitto MQTT broker
#
# Single instance, anonymous=false, no persistence (we don't need
# durable subscriptions — Frigate is the only consumer).
#
# Password file is at /srv/sv02/mosquitto/data/passwd. It is rendered
# by the separate render-mosquitto-passwd.service (a one-shot unit,
# not part of this Quadlet — the Quadlet's ExecStartPre caused
# Delegate-related cgroup issues that broke the inner podman run).
#
# To regenerate the passwd (e.g. after rotating MQTT_PASSWORD):
#   systemctl --user start render-mosquitto-passwd.service
#
# The sync.sh timer also runs render-mqtt-passwd.sh, so the file
# stays in sync with the env file across reboots.
[Unit]
Description=Mosquitto MQTT broker
After=network-online.target sv02-network.service
Wants=sv02-network.service
After=render-mosquitto-passwd.service
Wants=render-mosquitto-passwd.service

[Container]
Image=docker.io/library/eclipse-mosquitto:2.0
ContainerName=mosquitto
HostName=mosquitto.sv02.internal
Network=sv02.network
AutoUpdate=registry

# Bind-mount the entire /mosquitto dir from the host (we render
# mosquitto.conf + passwd into /srv/sv02/mosquitto/data, and the
# image expects its config dir layout under /mosquitto).
Volume=/srv/sv02/mosquitto/data:/mosquitto:z

# Environment (consumed by render-mqtt-passwd.sh)
EnvironmentFile=/srv/sv02/secrets/mosquitto.env

# Override the image's default entrypoint. The image's default
# CMD points at /mosquitto/config/mosquitto.conf, but we mount
# our config at /mosquitto/data/mosquitto.conf (rendered by the
# pre-start service).
Exec=mosquitto -c /mosquitto/data/mosquitto.conf

# Port
PublishPort=1883:1883

# Hardening (NOSUID/NODEV/NOEXEC are podman options; ProtectSystem
# and friends are systemd directives, see [Service] below)
SecurityLabelDisable=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30
# Note: ProtectSystem=strict and ProtectHome=true would hide
# /home/rkruit and /srv/sv02/ from the container. We rely on
# NoNewPrivileges=true and the rootless-podman isolation instead.
PrivateTmp=true

[Install]
WantedBy=default.target
