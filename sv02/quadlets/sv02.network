# Rootless podman network for sv02 services
#
# Caddy, Frigate, and Mosquitto all attach to this network so they can
# reach each other by name (e.g., caddy → frigate.sv02.internal:5000).
# The host (and the rest of your LAN) reach Caddy via the published ports
# on 80/443, then Caddy routes to the internal container names.
#
# Generated by the system on first `systemctl --user start sv02.network`.
# The IP range 10.89.0.0/24 is podman's default rootless network range,
# which means we get it for free with `podman network create` defaults.
# Explicitly pinning it here so that DNS name resolution is predictable
# and so that the Caddyfile (and any future containers) can hardcode it.
[Unit]
Description=sv02 podman network
After=network-online.target

[Network]
NetworkName=sv02
Driver=bridge
Subnet=10.89.0.0/24
Gateway=10.89.0.1
Label=app=sv02
Label=managed-by=quadlet

[Install]
WantedBy=default.target
