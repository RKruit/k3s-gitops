# Frigate NVR
#
# The Coral USB is on this host (the entire reason we're moving off
# Talos/k3s — Frigate + Coral + nodeSelector was always a fight).
#
# Translation from the k3s deployment (base/frigate/deployment.yaml):
#   - securityContext.privileged + caps → SecurityOpt=label=disable
#   - hostPath /opt/coral-libs/*.so → Volume bind-mounts (files at exact path)
#   - hostPath /dev/bus/usb, /sys/bus/usb → Volume bind-mounts
#   - emptyDir dshm/db/cache → none needed; Frigate creates these itself
#   - secretKeyRef → EnvironmentFile (host-side /srv/sv02/secrets/frigate-cam.env)
#   - Pod-level nodeSelector → no equivalent (we are the host!)
#
# Pitfall: the Coral's /dev/bus/usb must be bind-mounted into the
# container for the edgetpu runtime. Without it, libedgetpu returns
# NULL and Frigate falls back to XNNPACK CPU delegate silently.
[Unit]
Description=Frigate NVR with Coral EdgeTPU
After=network-online.target sv02-network.service
Wants=sv02-network.service
# Frigate's MQTT doesn't need to be up before Frigate starts —
# the Frigate MQTT bridge reconnects on its own. So no
# `Requires=mosquitto.service` here.

[Container]
Image=ghcr.io/blakeblackshear/frigate:0.16.1
ContainerName=frigate
HostName=frigate.sv02.internal
Network=sv02.network
AutoUpdate=registry

# === Volume mounts (bind-mounts from the host) ===
# Config (frigate.yml from Git, plus a writable /tmp)
Volume=/srv/sv02/frigate/config:/config:z
# Media (recordings — on the root fs in our NO_DISK=1 mode)
Volume=/srv/sv02/frigate/media:/media:z
# DB (frigate.db, persistent)
Volume=/srv/sv02/frigate/db:/db:z
# Coral USB runtime — bookworm-compatible .so files staged on the host
Volume=/opt/coral-libs/libedgetpu.so.1:/usr/local/lib/libedgetpu.so.1:ro,z
Volume=/opt/coral-libs/libusb-1.0.so.0:/usr/local/lib/libusb-1.0.so.0:ro,z
# USB device nodes (libusb opens these to talk to the Coral)
Volume=/dev/bus/usb:/dev/bus/usb:rslave,z
# USB sysfs (for enumeration)
Volume=/sys/bus/usb:/sys/bus/usb:ro,z

# === Environment ===
# Camera + MQTT credentials — host-side env files, NOT in Git
EnvironmentFile=/srv/sv02/secrets/frigate-cam.env
# Camera creds end up in $FRIGATE_CAM_USER / $FRIGATE_CAM_PASS
# frigate.yml uses these as env-var references in the RTSP URLs
# (the {FRIGATE_CAM_USER}/{FRIGATE_CAM_PASS} placeholders).
EnvironmentFile=/srv/sv02/secrets/frigate-mqtt.env
# MQTT creds end up in $FRIGATE_MQTT_USER / $FRIGATE_MQTT_PASSWORD
# frigate.yml uses these for the broker connection.
# The values here MUST match MQTT_USER/MQTT_PASSWORD in mosquitto.env
# (which is what the mosquitto container's passwd file is rendered from).

# === Static env (not secrets) ===
Environment=TZ=Europe/Amsterdam
Environment=CONFIG_FILE=/config/frigate.yml
Environment=LD_LIBRARY_PATH=/usr/local/lib
Environment=EDGETPU_SHARED_LIB=/usr/local/lib/libedgetpu.so.1
# The image's default entrypoint is /init (s6-overlay); keep that.
# Frigate reads CONFIG_FILE to find its config.
Exec=/init

# === Coral USB — must be privileged ===
# Frigate needs CAP_SYS_ADMIN + SYS_RAWIO for the Coral, and needs
# to bind privileged ports (8971 for TLS) and read all of /dev/bus/usb.
# Easier to just run privileged than to fight the capability set.
SecurityLabelDisable=true

# === Ports ===
# 5000 — internal plain HTTP (Caddy talks to this)
# 8554 — go2rtc RTSP (LAN-only access, useful for embedding)
# 1984 — go2rtc WebRTC
# 11984 — go2rtc API
#
# We do NOT publish 8971 publicly — Caddy proxies plain HTTP and
# terminates TLS itself. 8971 is bound to loopback only.
PublishPort=5000:5000
PublishPort=8554:8554
PublishPort=1984:1984
PublishPort=127.0.0.1:8971:8971

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=default.target
