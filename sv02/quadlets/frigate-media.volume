# Frigate media bind-mount: /srv/sv02/frigate/media → /media
# This is where recordings live. Should be on the SATA disk.
[Unit]
Description=Frigate media volume (SATA disk)

[Volume]
Type=bind
Source=/srv/sv02/frigate/media
Destination=/media
Options=rw,relabel=shared

[Install]
WantedBy=default.target
