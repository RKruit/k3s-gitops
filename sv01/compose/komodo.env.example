# Kopieer naar /srv/sv01-secrets/sv01.env en vul in (gebruikt via --env-file in de sync-unit
# én als env_file voor de komodo containers — secrets blijven buiten git)

CF_API_TOKEN=

COMPOSE_KOMODO_IMAGE_TAG=2
COMPOSE_KOMODO_BACKUPS_PATH=/srv/komodo-backups

KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=

KOMODO_HOST=https://komodo.oostrandpark.com
KOMODO_TITLE=Komodo sv01
KOMODO_INIT_ADMIN_USERNAME=rkruit
KOMODO_INIT_ADMIN_PASSWORD=

KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=true