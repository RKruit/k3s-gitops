# Authelia forward_auth snippet (2026-10-28): SSO-wal voor alle UI-routes.
# Route = `import (authelia)` vóór reverse_proxy; login-portal auth.oostrandpark.com.
# Uptime Kuma kan er dóór (Authelia-ACL-bypass op XFF 192.168.1.10 — Caddy levert
# de echte client-IP, test bewees 200/302-splitsing), authelia/configuration.yml).
# sv02-Caddy kan straks hetzelfde direct naar 192.168.1.10:9091 doen (Frigate).
(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

todo.oostrandpark.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import authelia
	reverse_proxy todo-app:80
}

komodo.oostrandpark.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import authelia
	reverse_proxy core:9120
}

# Monitoring (2026-10-24). kuma draait host-net; vanuit de caddy-container
# is hij via het host-IP bereikbaar. beszel gewoon via docker-netwerk.
kuma.oostrandpark.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import authelia
	reverse_proxy 192.168.1.10:3001
}

beszel.oostrandpark.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import authelia
	reverse_proxy beszel:8090
}

# Docs-site (2026-10-25): MkDocs in dezelfde compose-stack.
docs.oostrandpark.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import authelia
	reverse_proxy docs:8000
}

# Homepage (2026-10-26): dashboard met alle interne links.
homepage.oostrandpark.com {
