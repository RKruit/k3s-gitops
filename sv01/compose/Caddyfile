		dns cloudflare {env.CF_API_TOKEN}
	}
	import authelia
	reverse_proxy homepage:3000
}

# IT-Tools (2026-10-26 teruggezet uit de k3s-tijd): dev/web tools.
tools.oostrandpark.com {
