[Unit]
Description=GitHub push-webhook receiver (sv01 gitops deploy-trigger via Cloudflare Tunnel)
Wants=network-online.target
After=network-online.target

[Service]
User=rkruit
Group=rkruit
EnvironmentFile=/srv/sv01-secrets/gh-webhook.env
ExecStart=/usr/bin/python3 /opt/sv01-config/sv01/scripts/gh_webhook_receiver.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target