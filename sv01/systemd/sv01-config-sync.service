[Unit]
[Unit]
Description=GitOps sync sv01: git pull + host-side compose apply (host-side = veilig, ook voor periphery/core)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=rkruit
WorkingDirectory=/opt/sv01-config
ExecStart=/usr/bin/git -C /opt/sv01-config pull --ff-only
ExecStart=/usr/bin/docker compose --env-file /srv/sv01-secrets/sv01.env --project-name sv01 -f /opt/sv01-config/sv01/compose/docker-compose.yml up -d --remove-orphans